<article class="detalle">
  <img
    src="<%= mascota.imagen %>"
    alt="Ilustración de <%= mascota.nombre %>"
    class="tarjeta-imagen"
  />
  <p class="etiqueta"><%= mascota.especie%></p>
  <h1><%= mascota.nombre %></h1>
  <p class="edad"><%= mascota.edad.toLocaleString("es-AR") %> anios</p>
  <p><%= mascota.descripcion %></p>
  <p class="etiqueta"><%= mascota.estado%></p>
  <a href="/mascotas">Volver al catálogo</a>
</article>
